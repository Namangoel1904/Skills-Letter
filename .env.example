# ─────────────────────────────────────────────
#  TechPulse Newsletter — Environment Variables Template
#  Copy this file to `.env` and fill in your values
# ─────────────────────────────────────────────

# ── YouTube ──────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Playlist IDs (comma-separated; first = Saved Shorts, second = curated Tech playlist)
YOUTUBE_PLAYLIST_IDS=PLxxxxSavedShortsId,PLxxxxTechPlaylistId
# Playlist friendly names (same order, comma-separated)
YOUTUBE_PLAYLIST_NAMES=Saved Shorts,Tech Picks

# ── Gemini AI ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_from_ai_studio

# ── Database (PostgreSQL on Render) ──────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/techpulse
# For local dev you can use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/techpulse

# ── Email (Resend) ───────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=TechPulse Newsletter

# ── App ──────────────────────────────────────
ADMIN_PASSWORD=change_me_to_something_strong
FRONTEND_URL=http://localhost:3000
# For production: FRONTEND_URL=https://yourdomain.com

# ── Scheduler ────────────────────────────────
# Default: Every Friday at 5:00 PM IST (11:30 UTC)
NEWSLETTER_CRON_DEFAULT=30 11 * * 5
# Timezone for scheduler display
SCHEDULER_TIMEZONE=Asia/Kolkata

# ── Feature Flags ────────────────────────────
# Maximum videos per newsletter edition (0 = no limit)
MAX_VIDEOS_PER_EDITION=20
# Days to look back when scanning playlists for new videos
PLAYLIST_LOOKBACK_DAYS=7
