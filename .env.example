# ─────────────────────────────────────────────────────────────────────────────
#  BeingNotified Skill Letter — Environment Variables Template
#  Copy this file to `.env` and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── YouTube Data API v3 ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Playlist IDs (comma-separated; e.g. PLT57M0_CWy0E...)
YOUTUBE_PLAYLIST_IDS=PLT57M0_CWy0E
# Friendly names matching order above
YOUTUBE_PLAYLIST_NAMES=Skill Letter

# ── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# ── Database (PostgreSQL via asyncpg) ─────────────────────────────────────────
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/techpulse
# Render: Render auto-injects DATABASE_URL (backend normalizes to postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/techpulse

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Skill Letter

# ── App & Security ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_me_to_a_strong_password
FRONTEND_URL=http://localhost:3000
# For Render deployment: FRONTEND_URL=https://skill-letter-frontend.onrender.com

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Default: Every Friday at 5:00 PM IST (11:30 UTC)
NEWSLETTER_CRON_DEFAULT=30 11 * * 5
SCHEDULER_TIMEZONE=Asia/Kolkata

# ── Feature Flags ─────────────────────────────────────────────────────────────
MAX_VIDEOS_PER_EDITION=20
PLAYLIST_LOOKBACK_DAYS=7
